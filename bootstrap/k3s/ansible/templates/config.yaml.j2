# Managed by Ansible (bootstrap/k3s/ansible). Manual edits are overwritten.
write-kubeconfig-mode: "0600"
secrets-encryption: true
tls-san:
  - 127.0.0.1
disable:
  - traefik
  - servicelb
kube-apiserver-arg:
  - service-account-issuer={{ issuer_url }}
  - service-account-issuer={{ k3s_default_issuer }}
  - service-account-jwks-uri={{ issuer_url }}/openid/v1/jwks
